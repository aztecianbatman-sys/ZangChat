{
  "name":"zangchat",
  "version":"0.1.1",
  "private":true,
  "description":"ZangChat — ObsidianUI v1 desktop chat client.",
  "main":"out/main/index.js",
  "scripts":{
    "dev":"electron-vite dev",
    "start":"npm run build && electron .",
    "build":"electron-vite build",
    "package:win":"npm run build && electron-builder --win --x64",
    "preview":"electron-vite preview",
    "typecheck":"tsc --noEmit"
  },
  "dependencies":{
    "@supabase/supabase-js":"^2.57.4",
    "dotenv":"^17.2.2",
    "lucide-react":"^0.468.0",
    "react":"^19.1.1",
    "react-dom":"^19.1.1"
  },
  "devDependencies":{
    "@types/node":"^22.18.6",
    "@types/react":"^19.1.13",
    "@types/react-dom":"^19.1.9",
    "@vitejs/plugin-react":"^5.0.4",
    "@tailwindcss/vite":"^4.1.13",
    "electron":"37.2.6",
    "electron-builder":"^26.0.12",
    "electron-vite":"^4.0.1",
    "tailwindcss":"^4.1.13",
    "typescript":"^5.9.2",
    "vite":"^7.1.5"
  },
  "allowScripts":{
    "electron":true,
    "esbuild":true
  },
  "build":{
    "appId":"com.zangchat.desktop",
    "productName":"ZangChat",
    "directories":{
      "output":"release"
    },
    "files":[
      "out/**/*",
      "package.json"
    ],
    "asar":true,
    "win":{
      "target":[
        {
          "target":"nsis",
          "arch":["x64"]
        },
        {
          "target":"portable",
          "arch":["x64"]
        }
      ],
      "artifactName":"ZangChat-${version}-${arch}.${ext}"
    },
    "nsis":{
      "oneClick":false,
      "allowToChangeInstallationDirectory":true,
      "createDesktopShortcut":true,
      "createStartMenuShortcut":true
    }
  }
}
